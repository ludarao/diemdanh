{
  "name": "diemdanh-gps",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "Điểm danh GPS và dashboard quản trị PostgreSQL",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.js",
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "deploy": "npx vercel --prod"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "exceljs": "^4.4.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "esbuild": "^0.25.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
